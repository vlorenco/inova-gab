# ─────────────────────────────────────────────────────────────────────────────
# InovaGAB backend — exemplo de configuracao.
#
# ATENCAO: este arquivo e uma REFERENCIA, nao e lido pela aplicacao.
# O Spring Boot nao carrega .env sozinho. Exporte as variaveis no shell que vai
# iniciar a API, no MESMO terminal:
#
#   PowerShell:  $env:GEMINI_API_KEY = "sua-chave"
#   Git Bash:    export GEMINI_API_KEY="sua-chave"
#
# Definir a variavel depois que a API ja subiu nao tem efeito: reinicie a API.
# NUNCA comite valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB
MONGODB_URI=mongodb://localhost:27017/inovagab

# JWT — use ao menos 32 caracteres. Gere um valor aleatorio proprio.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_EXPIRATION_MS=86400000

# Google Gemini — obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Porta da API
SERVER_PORT=8080
