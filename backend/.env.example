# ─────────────────────────────────────────────────────────────────────────────
# InovaGAB backend — exemplo de configuracao.
# Copie para .env (que esta no .gitignore) ou exporte como variaveis de ambiente.
# NUNCA comite valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB
MONGODB_URI=mongodb://localhost:27017/inovagab

# JWT — use ao menos 32 caracteres. Gere um valor aleatorio proprio.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_EXPIRATION_MS=86400000

# Google Gemini — obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Porta da API
SERVER_PORT=8080
